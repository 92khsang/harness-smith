{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/92khsang/harness-smith/schemas/operation-result.schema.json",
  "title": "OperationResult",
  "description": "The one envelope every harness-smith operation emits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "mode",
    "status",
    "diagnostics",
    "changes",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "oneOf": [
        {
          "enum": [
            "init",
            "surface-audit",
            "artifact-route",
            "artifact-manage",
            "entrypoint-manage",
            "harness-validate",
            "config-gc",
            "context-audit",
            "skill-stocktake",
            "skill-scout",
            "skill-create",
            "rules-distill"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "read",
        "plan",
        "apply"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "violations",
        "usage-error",
        "environment-error"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": null
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "mode": {
            "const": "read"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "read"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "changes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "surface-audit"
          },
          "status": {
            "enum": [
              "ok",
              "violations"
            ]
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/surfaceAuditData"
          }
        }
      }
    }
  ],
  "$defs": {
    "diagnosticCode": {
      "enum": [
        "HS-ARTIFACT-TYPE-UNKNOWN",
        "HS-ARTIFACT-UNACKNOWLEDGED-DRIFT",
        "HS-AUTHORITY-CLASSIFICATION-REQUIRED",
        "HS-AUTHORITY-CONFLICT",
        "HS-AUTHORITY-CONTESTED-WRITE",
        "HS-AUTHORITY-DECLARED-PLUGIN-MISSING",
        "HS-AUTHORITY-LOCK-MANIFEST-MISMATCH",
        "HS-AUTHORITY-ORPHAN-DECLARATION",
        "HS-AUTHORITY-REVIEW-REQUIRED",
        "HS-AUTHORITY-UNDECLARED-EXTERNAL-WRITER",
        "HS-BOOTSTRAP-FAILED",
        "HS-CLI-USAGE",
        "HS-COMPAT-PROBE-UNAVAILABLE",
        "HS-COMPAT-REGRESSION",
        "HS-COMPAT-UNVERIFIED",
        "HS-CONSUMED-ARTIFACT-MISSING",
        "HS-CONSUMER-BINDING-CHANGED",
        "HS-CONSUMER-EVIDENCE-MISSING",
        "HS-CONSUMER-PLUGIN-MISSING",
        "HS-CONSUMER-REVISION-MISMATCH",
        "HS-CONSUMER-SKILL-MISSING",
        "HS-CONSUMER-VERSION-MISMATCH",
        "HS-DEPENDENCY-ON-TRANSIENT-SOURCE",
        "HS-DOC-UNREGISTERED-IN-RESERVED-PATH",
        "HS-EFFECTIVE-HARNESS-UNCERTAIN",
        "HS-ENFORCEMENT-ORPHAN",
        "HS-ENFORCEMENT-PLACEMENT-UNKNOWN",
        "HS-ENFORCEMENT-TARGET-MISSING",
        "HS-ENTRYPOINT-BUDGET-EXCEEDED",
        "HS-ENTRYPOINT-CONTRACT-VIOLATION",
        "HS-ENTRYPOINT-DUPLICATE",
        "HS-GC-CANDIDATE-UNRECOVERABLE",
        "HS-HARNESS-RELEVANCE-DOWNGRADED",
        "HS-HOOK-CONTAINER-FILE-UNREADABLE",
        "HS-HOOK-CONTAINER-INVALID",
        "HS-HOOK-CONTAINER-UNPARSEABLE",
        "HS-HOOK-LOCATOR-AMBIGUOUS",
        "HS-HOOK-LOCATOR-UNRESOLVED",
        "HS-HOOK-RELOCATED",
        "HS-INTERNAL-ERROR",
        "HS-LOCK-INVALID",
        "HS-MANIFEST-INVALID",
        "HS-OVERLAP-IDENTIFIER-COLLISION",
        "HS-PACKAGE-INVALID",
        "HS-PACKAGE-VALIDATOR-FAILED",
        "HS-PACKAGE-VALIDATOR-UNAVAILABLE",
        "HS-PLACEMENT-INVALID",
        "HS-PLAN-ALREADY-APPLIED",
        "HS-PLAN-DOCUMENT-INVALID",
        "HS-PLAN-RESUMED",
        "HS-PLAN-STALE",
        "HS-PLUGIN-COMPONENT-PATH-ESCAPES-ROOT",
        "HS-PLUGIN-MANIFEST-AMBIGUOUS",
        "HS-PLUGIN-SHADOWED-DEFAULT-DIR",
        "HS-PROVENANCE-MISSING",
        "HS-REFERENCE-DANGLING",
        "HS-REPOSITORY-ROOT-NOT-FOUND",
        "HS-RULE-ENFORCEMENT-UNVERIFIED",
        "HS-RULE-FILE-UNREADABLE",
        "HS-RULE-FRONTMATTER-INVALID",
        "HS-RULE-ID-DUPLICATE",
        "HS-RULE-METADATA-UNREADABLE",
        "HS-RUNTIME-BELOW-MINIMUM",
        "HS-SCOPE-LEAKAGE",
        "HS-SKILL-NAME-SHADOWED",
        "HS-STANDARD-UPGRADE-AVAILABLE",
        "HS-STANDARD-VERSION-INCOMPATIBLE",
        "HS-VALIDATOR-TOO-OLD"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "subject",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "message": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "affected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "remediation": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator"
      ],
      "properties": {
        "kind": {
          "enum": [
            "artifact",
            "container",
            "surface",
            "relation",
            "environment"
          ]
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "digestBefore",
        "digestAfter",
        "applied",
        "patch"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/locator"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "digestBefore": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "digestAfter": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "patch": {
          "$ref": "#/$defs/patch"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "digestBefore": {
                "type": "null"
              },
              "digestAfter": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "digestBefore": {
                "type": "string"
              },
              "digestAfter": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "digestBefore": {
                "type": "string"
              },
              "digestAfter": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "enum": [
            "unified",
            "json-pointer-ops"
          ]
        },
        "content": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "unified"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "json-pointer-ops"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/pointerOperation"
                }
              }
            }
          }
        }
      ]
    },
    "pointerOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "pointer",
        "before",
        "after"
      ],
      "properties": {
        "op": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "before": {},
        "after": {}
      }
    },
    "managementAuthority": {
      "enum": [
        "local",
        "harness-smith",
        "external-plugin",
        "unknown"
      ]
    },
    "governanceSet": {
      "enum": [
        "inventoried",
        "governed",
        "managed",
        "advisory",
        "unclassified",
        "observed",
        "governed-harness"
      ]
    },
    "capabilityValue": {
      "enum": [
        "managed",
        "observed-only",
        "unsupported"
      ]
    },
    "surfaceAuditData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "containers",
        "observations"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoriedArtifact"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactContainer"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeComponentObservation"
          }
        }
      }
    },
    "inventoriedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "type",
        "scope",
        "representation",
        "provenance",
        "managementAuthority",
        "activation",
        "activationCause",
        "harnessRelevant",
        "sets"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "type": {
          "enum": [
            "entry-point",
            "rule",
            "skill",
            "agent",
            "hook",
            "enforcement",
            "documentation",
            "decision-record"
          ]
        },
        "scope": {
          "enum": [
            "repository",
            "plugin",
            "user-global",
            "external",
            "managed-policy"
          ]
        },
        "representation": {
          "enum": [
            "file",
            "directory",
            "legacy-command",
            "container-entry"
          ]
        },
        "provenance": {
          "enum": [
            "authored",
            "generated",
            "imported",
            "adopted"
          ]
        },
        "managementAuthority": {
          "oneOf": [
            {
              "$ref": "#/$defs/managementAuthority"
            },
            {
              "type": "null"
            }
          ]
        },
        "activation": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ]
        },
        "activationCause": {
          "oneOf": [
            {
              "enum": [
                "managed-policy-uninspectable",
                "workspace-trust-unknown",
                "plugin-agent-hook-support-unverified",
                "runtime-state-not-read",
                "allow-managed-hooks-only",
                "disable-all-hooks-managed",
                "disable-all-hooks"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "harnessRelevant": {
          "type": "boolean"
        },
        "sets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/governanceSet"
          },
          "contains": {
            "const": "inventoried"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "repository",
                  "plugin"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "managementAuthority": {
                "$ref": "#/$defs/managementAuthority"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "user-global",
                  "external",
                  "managed-policy"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "managementAuthority": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "artifactContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "format",
        "source",
        "scope",
        "settingsLayer",
        "holds"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "format": {
          "enum": [
            "json",
            "yaml-frontmatter"
          ]
        },
        "source": {
          "enum": [
            "shared-project-settings",
            "project-local-settings",
            "user-settings",
            "managed-policy-settings",
            "plugin-hook-file",
            "plugin-manifest",
            "skill-frontmatter",
            "subagent-frontmatter"
          ]
        },
        "scope": {
          "enum": [
            "repository",
            "plugin",
            "user-global",
            "external",
            "managed-policy"
          ]
        },
        "settingsLayer": {
          "oneOf": [
            {
              "enum": [
                "shared-project",
                "project-local",
                "user",
                "managed-policy"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "holds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "shared-project-settings"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "const": "shared-project"
              },
              "scope": {
                "const": "repository"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "project-local-settings"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "const": "project-local"
              },
              "scope": {
                "const": "repository"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "user-settings"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "const": "user"
              },
              "scope": {
                "const": "user-global"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "managed-policy-settings"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "const": "managed-policy"
              },
              "scope": {
                "const": "managed-policy"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "plugin-hook-file"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "plugin-manifest"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "skill-frontmatter"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "subagent-frontmatter"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "settingsLayer": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "runtimeComponentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "component",
        "scope",
        "capabilities"
      ],
      "properties": {
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "component": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "repository",
            "plugin",
            "user-global",
            "external",
            "managed-policy"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inventory",
            "structuralCheck",
            "lifecycleAdvice",
            "mutation"
          ],
          "properties": {
            "inventory": {
              "$ref": "#/$defs/capabilityValue"
            },
            "structuralCheck": {
              "$ref": "#/$defs/capabilityValue"
            },
            "lifecycleAdvice": {
              "$ref": "#/$defs/capabilityValue"
            },
            "mutation": {
              "$ref": "#/$defs/capabilityValue"
            }
          }
        }
      }
    }
  }
}
